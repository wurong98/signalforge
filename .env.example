# HTTP 端口
PORT=8787
# 监听地址。默认仅本机；给局域网他人体验用 `npm run share`
HOST=127.0.0.1
# SQLite 文件路径
DB_PATH=./data/signalforge.db
# 管理密码哈希文件：首次打开页面时设置密码；忘记密码删除此文件即可重新设置
ADMIN_FILE=./data/admin.json

# 自然语言解析：OpenAI 兼容接口（默认 DeepSeek；deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用）
# 不配置时回退到内置规则解析器
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 是否发送 DeepSeek 的 thinking 参数（默认按 LLM_BASE_URL 是否为 deepseek.com 判断；其他端点可能拒绝未知参数）
# LLM_THINKING_PARAM=true

# Binance WebSocket 端点（被墙环境可换 wss://data-stream.binance.vision）
BINANCE_WS_URL=wss://stream.binance.com:9443
# U 本位永续合约端点（只在有合约 Signal 时连接）。必须带 /market 路由：aggTrade / ticker 只在该路由推送
# BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market
# BINANCE_FUTURES_REST_URL=https://fapi.binance.com
# 启动时订阅的交易对（逗号分隔）；合约写 .P 后缀，如 BTCUSDT.P
SYMBOLS=BTCUSDT

# 默认禁止 Webhook 指向内网/回环地址（防 SSRF）。本地调试时可设为 true
ALLOW_PRIVATE_WEBHOOKS=false

# 数据保留
METRIC_RETENTION_DAYS=7

# 版本号：默认读 git；不是 git 目录（打包部署）时用它指定，显示在页面底部
# APP_COMMIT=
